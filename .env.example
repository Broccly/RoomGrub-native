# RoomGrub-backend (FastAPI) base URL, no trailing slash, no /api/v1 suffix.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Google OAuth "Web application" client ID, used by expo-auth-session to obtain a
# raw Google id_token for POST /api/v1/auth/login. Create one in Google Cloud Console
# (APIs & Services > Credentials) — see docs/AUTH.md.

# PRODUCTION
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=673228173077-rll4dnc7cdb13d50ttbvgfu1niigvl8a.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=673228173077-v0d0ijsl0jf9mu4e6363vgsu9070301h.apps.googleusercontent.com
